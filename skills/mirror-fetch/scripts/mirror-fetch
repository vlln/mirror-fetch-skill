#!/usr/bin/env python3
"""mirror-fetch — 通用上游文件下载镜像引擎（配置表驱动，probe→rewrite→fetch→verify）。

参考 mip（configs/mip.yaml 镜像表 + probe 选最快 + rewrite/pull/retag）的方式，
但面向**文件/URL 下载**而非 OCI 镜像：当 huggingface.co 等上游（见
configs/mirrors.json 的表）下载慢/超时/被封锁时，探测候选镜像可达性 → 重写 URL →
curl -C - 续传下载 → 校验。

设计约束：
- python3 stdlib only（3.9+，runtime 镜像 python3.10 可用），无第三方依赖；
- 下载委托系统 curl（BL-024 续传纪律：`curl -C -`，Range/HTTP 206）；
- 镜像/凭据/无镜像三类问题严格分开：本工具只治「公开文件慢/被封」；
  gated/需凭据（401/407）会如实报 auth，镜像解决不了；
- 每次使用前 probe（镜像可用性会漂移），不硬编码镜像；
- 输出含实际使用的 endpoint（provenance），供跨批次可比性记录。

用法摘要见 references/mirror-fetch-cli.md；`mirror-fetch <cmd> --help` 看各子命令。
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

DEFAULT_CONFIG = Path(__file__).resolve().parent.parent / "configs" / "mirrors.json"
PROBE_CHUNK = 256  # probe 时 GET Range 读取的字节数

# ── 配置 ──────────────────────────────────────────────────────────────
_MODE_HOST_REPLACE = "host-replace"
_MODE_PREFIX = "prefix"
_MODES = (_MODE_HOST_REPLACE, _MODE_PREFIX)


def default_config_path() -> Path:
    override = os.environ.get("MIRROR_FETCH_CONFIG")
    return Path(override) if override else DEFAULT_CONFIG


def load_config(path=None) -> dict:
    """读镜像表并校验形状。返回 {upstream: {aliases, mirrors: [{host, mode, note}]}}。"""
    p = Path(path) if path else default_config_path()
    try:
        raw = json.loads(p.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise SystemExit(f"error: 镜像表不存在: {p}")
    except json.JSONDecodeError as e:
        raise SystemExit(f"error: 镜像表不是合法 JSON: {p}: {e}")
    upstreams = raw.get("upstreams")
    if not isinstance(upstreams, dict) or not upstreams:
        raise SystemExit(f"error: {p} 缺 upstreams 映射")
    cfg = {}
    for up, body in upstreams.items():
        if not isinstance(body, dict) or "mirrors" not in body:
            raise SystemExit(f"error: 上游 {up!r} 缺 mirrors 列表")
        aliases = [str(a) for a in body.get("aliases", [])]
        mirrors = []
        for m in body["mirrors"]:
            if isinstance(m, str):
                host, mode = _split_host_mode(m)
                note = None
            else:
                host, mode = _split_host_mode(str(m.get("host", "")))
                note = m.get("note")
            if not host:
                raise SystemExit(f"error: 上游 {up!r} 有空的镜像 host")
            mirrors.append({"host": host, "mode": mode, "note": note})
        cfg[up] = {"aliases": aliases, "mirrors": mirrors}
    return cfg


def _split_host_mode(s: str):
    if ":" in s:
        host, mode = s.rsplit(":", 1)
        if mode not in _MODES:
            raise SystemExit(f"error: 未知 mode {mode!r}（可选 {_MODES}）")
        return host, mode
    return s, _MODE_HOST_REPLACE


# ── URL ───────────────────────────────────────────────────────────────
def normalize_url(url: str) -> str:
    if "://" not in url:
        url = "https://" + url
    parts = urllib.parse.urlparse(url)
    if not parts.netloc or any(ch.isspace() for ch in parts.netloc):
        raise ValueError(f"无法解析 URL: {url}")
    return urllib.parse.urlunparse(parts)


def lookup_upstream(url: str, cfg: dict):
    """URL host 命中某上游（含别名）→ (upstream_key, body)；否则 (None, None)。"""
    host = urllib.parse.urlparse(normalize_url(url)).netloc.split(":")[0].lower()
    for up, body in cfg.items():
        aliases = body.get("aliases") or []
        if host == up.lower() or host in (a.lower() for a in aliases):
            return up, body
    return None, None


def rewrite_url(url: str, mirror: dict) -> str:
    """按 mode 重写：host-replace 换域保 path/query；prefix = 镜像域 + 原完整 URL。"""
    u = normalize_url(url)
    parsed = urllib.parse.urlparse(u)
    if mirror["mode"] == _MODE_PREFIX:
        return f"https://{mirror['host']}/{u}"
    # host-replace
    return urllib.parse.urlunparse(
        (parsed.scheme, mirror["host"], parsed.path, parsed.params, parsed.query, parsed.fragment)
    )


def list_candidates(url: str, cfg: dict):
    """按配置顺序展开候选镜像 [{'host','mode','url'}]；URL 不在表中 → []。"""
    up, body = lookup_upstream(url, cfg)
    if up is None:
        return []
    out = []
    for m in body["mirrors"]:
        out.append({"host": m["host"], "mode": m["mode"], "note": m.get("note"),
                    "url": rewrite_url(url, m)})
    return out


# ── probe ─────────────────────────────────────────────────────────────
def _probe_one(url: str, timeout: float) -> dict:
    """GET Range: bytes=0..PROBE_CHUNK-1，读 PROBE_CHUNK 字节后即断。

    返回 {ok, status, latency_ms, cause}；cause ∈ ok/blocked/auth/gone/timeout/conn/http/other。
    blocked=403/429/451；auth=401/407（需凭据，镜像无效）；gone=404/410。
    """
    req = urllib.request.Request(url, method="GET", headers={"Range": f"bytes=0-{PROBE_CHUNK - 1}"})
    start = time.monotonic()
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            resp.read(PROBE_CHUNK)
            elapsed = (time.monotonic() - start) * 1000.0
            status = getattr(resp, "status", 200)
            cause = "ok"
            if status in (200, 206, 301, 302, 303, 307, 308):
                cause = "ok"
            elif status in (401, 407):
                cause = "auth"
            elif status in (403, 429, 451):
                cause = "blocked"
            elif status in (404, 410):
                cause = "gone"
            else:
                cause = "http"
            return {"ok": cause == "ok", "status": status, "latency_ms": round(elapsed, 1),
                    "cause": cause}
    except urllib.error.HTTPError as e:
        elapsed = (time.monotonic() - start) * 1000.0
        cause = "auth" if e.code in (401, 407) else "blocked" if e.code in (403, 429, 451) \
            else "gone" if e.code in (404, 410) else "http"
        getattr(e, "close", lambda: None)()  # 释放响应对象，避免 ResourceWarning
        return {"ok": False, "status": e.code, "latency_ms": round(elapsed, 1), "cause": cause}
    except (urllib.error.URLError, socket.timeout, TimeoutError, ConnectionError, OSError) as e:
        elapsed = (time.monotonic() - start) * 1000.0
        cause = "timeout" if isinstance(e, (socket.timeout, TimeoutError)) else "conn"
        return {"ok": False, "status": None, "latency_ms": round(elapsed, 1), "cause": cause}
    except Exception:  # noqa: BLE001 —— probe 失败不应中断整体
        return {"ok": False, "status": None, "latency_ms": None, "cause": "other"}


def probe_all(url: str, cfg: dict, timeout: float = 8.0, probe_fn=None):
    """直接 URL + 各候选镜像依次 probe。返回直连 + 镜像结果列表。"""
    probe = probe_fn or _probe_one
    direct = {"kind": "direct", "host": urllib.parse.urlparse(normalize_url(url)).netloc,
              "url": normalize_url(url), "result": probe(normalize_url(url), timeout)}
    rows = [direct]
    for c in list_candidates(url, cfg):
        r = probe(c["url"], timeout)
        rows.append({"kind": "mirror", "host": c["host"], "mode": c["mode"],
                     "url": c["url"], "note": c.get("note"), "result": r})
    return rows


def choose_endpoint(rows: dict, prefer: str = "auto") -> dict:
    """从 probe 结果选下载端点。prefer ∈ auto/direct/<host>。

    规则：auth/gone/blocked 候选不可选（blocked 可尝试镜像但直连被封时镜像常可用，
    由 probe 各自独立判定）；auto = 可达（ok）候选中延迟最小者；全不可达 → None。
    """
    reachable = [r for r in rows if r["result"]["ok"]]
    if prefer == "direct":
        want = [r for r in rows if r["kind"] == "direct"]
        return want[0] if want else None
    if prefer != "auto":
        want = [r for r in rows if r.get("host") == prefer]
        return want[0] if want else None
    if not reachable:
        return None
    return min(reachable, key=lambda r: (r["result"]["latency_ms"] is None, r["result"]["latency_ms"]))


# ── fetch ─────────────────────────────────────────────────────────────
def _curl_cmd(url: str, out: Path, resume: bool, connect_timeout: int) -> list:
    curl = os.environ.get("MIRROR_FETCH_CURL") or shutil.which("curl")
    if not curl:
        raise SystemExit("error: 需要 curl（下载委托 curl -C -，见 BL-024 续传纪律）")
    cmd = [curl, "--fail", "--location", "-sS", "--connect-timeout", str(connect_timeout),
           "--retry", "3", "--retry-all-errors"]
    if resume:
        cmd += ["-C", "-"]
    cmd += ["-o", str(out), url]
    return cmd


def checksum_sha256(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def fetch(url: str, out: Path, cfg: dict, prefer: str = "auto", timeout: float = 8.0,
          resume: bool = True, sha256: str | None = None, connect_timeout: int = 15,
          probe_fn=None) -> dict:
    """probe → 选端点 → curl 下载 → 校验。返回结果 dict（调用方按 exit 码处置）。"""
    rows = probe_all(url, cfg, timeout=timeout, probe_fn=probe_fn)
    chosen = choose_endpoint(rows, prefer)
    if chosen is None:
        return {"ok": False, "stage": "probe", "rows": rows, "chosen": None,
                "error": "所有候选（直连+镜像）均不可达；请核对 URL 形式与 gated/凭据状态"}
    target = chosen["url"]
    result = {"ok": False, "stage": "fetch", "rows": rows,
              "chosen": {"kind": chosen["kind"], "host": chosen.get("host"),
                         "mode": chosen.get("mode"), "url": target}}
    out.parent.mkdir(parents=True, exist_ok=True)
    cmd = _curl_cmd(target, out, resume, connect_timeout)
    started = time.monotonic()
    proc = subprocess.run(cmd, capture_output=True, text=True)
    result["elapsed_s"] = round(time.monotonic() - started, 1)
    if proc.returncode != 0:
        result["error"] = (proc.stderr or proc.stdout or "").strip()[:500] or f"curl exit {proc.returncode}"
        return result
    size = out.stat().st_size if out.exists() else 0
    result["size_bytes"] = size
    result["sha256"] = checksum_sha256(out) if size else None
    if sha256:
        if result["sha256"] != sha256:
            result["ok"] = False
            result["stage"] = "verify"
            result["error"] = f"sha256 不符: 期望 {sha256} 实得 {result['sha256']}"
            return result
    result["ok"] = size > 0
    if not result["ok"]:
        result["stage"] = "verify"
        result["error"] = "下载产物为空文件"
    return result


# ── CLI ───────────────────────────────────────────────────────────────
def _fmt_row(r: dict) -> str:
    res = r["result"]
    tag = {"ok": "OK", "blocked": "BLOCKED", "auth": "AUTH(需凭据)", "gone": "GONE(404)",
           "timeout": "TIMEOUT", "conn": "CONN", "http": f"HTTP {res['status']}",
           "other": "OTHER"}[res["cause"]]
    lat = f"{res['latency_ms']}ms" if res["latency_ms"] is not None else "-"
    kind = "直连" if r["kind"] == "direct" else f"镜像[{r.get('mode')}]"
    return f"{kind:16s} {r.get('host',''):24s} {tag:16s} {lat:10s} {r['url']}"


def cmd_list(args, cfg) -> None:
    for up, body in cfg.items():
        print(f"{up}  aliases={body['aliases'] or '-'}")
        for m in body["mirrors"]:
            note = f"  # {m['note']}" if m.get("note") else ""
            print(f"  - {m['host']}:{m['mode']}{note}")


def cmd_probe(args, cfg) -> None:
    rows = probe_all(args.url, cfg, timeout=args.timeout)
    if args.json:
        print(json.dumps({"url": args.url, "rows": rows}, ensure_ascii=False, indent=2))
        return
    for r in rows:
        print(_fmt_row(r))
    ok = [r for r in rows if r["result"]["ok"]]
    print(f"可达: {len(ok)}/{len(rows)}" if ok else "全部不可达")


def cmd_rewrite(args, cfg) -> None:
    cands = list_candidates(args.url, cfg)
    if not cands:
        print(f"{args.url}\n  （不在镜像表内：上游 = {urllib.parse.urlparse(normalize_url(args.url)).netloc}）")
        return
    print(f"直连: {normalize_url(args.url)}")
    for c in cands:
        print(f"  {c['mode']:12s} {c['url']}")


def cmd_check(args, cfg) -> None:
    """判定报告：区分 可达 / 被封(403) / 需凭据(401) / 不存在(404) / 网络(超时) / 无镜像。"""
    rows = probe_all(args.url, cfg, timeout=args.timeout)
    if args.json:
        print(json.dumps({"url": args.url, "rows": rows}, ensure_ascii=False, indent=2))
        return
    for r in rows:
        print(_fmt_row(r))
    causes = sorted({r["result"]["cause"] for r in rows})
    if not rows or all(not r["result"]["ok"] for r in rows):
        print("结论: 无可用端点。原因分类:", ", ".join(causes))
        if "auth" in causes:
            print("  → 含需凭据(401/407)：gated 仓库/凭据问题，镜像无效，需凭据注入通道")
        if "gone" in causes:
            print("  → 含 404：先核对上游 URL 形式（models vs datasets 路径）是否与来源一致")
        if "blocked" in causes:
            print("  → 含 403/429：环境级封锁信号，镜像可达性见上")
        if "timeout" in causes or "conn" in causes:
            print("  → 含超时/连接失败：网络质量问题（可续传重试，非不可获取）")


def cmd_fetch(args, cfg) -> None:
    res = fetch(args.url, Path(args.out), cfg, prefer=args.mirror, timeout=args.timeout,
                resume=not args.no_resume, sha256=args.sha256)
    if args.json:
        print(json.dumps(res, ensure_ascii=False, indent=2))
    else:
        if res["ok"]:
            ep = res["chosen"]
            kind = "直连" if ep["kind"] == "direct" else f"镜像 {ep['host']} ({ep['mode']})"
            print(f"OK {args.out}  {res['size_bytes']} bytes  {res['elapsed_s']}s  via {kind}")
            if res["sha256"]:
                print(f"sha256 {res['sha256']}")
            print(f"endpoint {ep['url']}")
        else:
            print(f"FAILED [{res['stage']}]: {res.get('error', '')}")
            for r in res.get("rows", []):
                print("  " + _fmt_row(r))
    sys.exit(0 if res["ok"] else (4 if res["stage"] == "verify" else 3))


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(prog="mirror-fetch", description="通用镜像下载引擎（probe→rewrite→fetch→verify）")
    ap.add_argument("--config", default=None, help="镜像表 JSON 路径（默认随脚本的 configs/mirrors.json）")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p_list = sub.add_parser("list", help="列出镜像表")
    p_list.set_defaults(fn=cmd_list)
    p_probe = sub.add_parser("probe", help="探测直连与各镜像可达性/延迟")
    p_probe.add_argument("url")
    p_probe.add_argument("--timeout", type=float, default=8.0)
    p_probe.add_argument("--json", action="store_true")
    p_probe.set_defaults(fn=cmd_probe)
    p_rewrite = sub.add_parser("rewrite", help="展示候选重写 URL")
    p_rewrite.add_argument("url")
    p_rewrite.set_defaults(fn=cmd_rewrite)
    p_check = sub.add_parser("check", help="可达性判定报告（未获取 vs 不可获取 决策用）")
    p_check.add_argument("url")
    p_check.add_argument("--timeout", type=float, default=8.0)
    p_check.add_argument("--json", action="store_true")
    p_check.set_defaults(fn=cmd_check)
    p_fetch = sub.add_parser("fetch", help="探测→选端点→curl -C - 下载→校验")
    p_fetch.add_argument("url")
    p_fetch.add_argument("-o", "--out", required=True)
    p_fetch.add_argument("--mirror", default="auto",
                         help="auto/direct/<host>（默认 auto：可达候选中延迟最小）")
    p_fetch.add_argument("--timeout", type=float, default=8.0, help="probe 超时秒")
    p_fetch.add_argument("--no-resume", action="store_true", help="不用 curl -C -")
    p_fetch.add_argument("--sha256", default=None, help="下载后校验 sha256")
    p_fetch.add_argument("--json", action="store_true")
    p_fetch.set_defaults(fn=cmd_fetch)
    return ap


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    cfg = load_config(args.config)
    args.fn(args, cfg)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit as e:
        raise e
    except KeyboardInterrupt:
        sys.exit(130)
