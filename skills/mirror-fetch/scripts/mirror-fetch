#!/usr/bin/env python3
"""mirror-fetch — 镜像站知识库查询器（知识库，不是下载器）。

设计立场：复现 agent 缺的不是下载能力（curl 人人会），是「该用哪个镜像、镜像站
怎么映射到 URL」的**知识**。本工具只做知识库动作：

  - lookup <url|host>   命中上游 → 打印 howto + 候选镜像 + 具体可用 URL 示例
  - list                列出知识库里的上游与镜像
  - search <关键词>      搜上游/镜像/note
  - add <upstream> <镜像URL>   新增/更新镜像条目（离线治理：去重、mode 枚举、日期戳）
  - validate            知识库完整性检查（CI/测试用）

下载本身交给 agent：拿到镜像地址后用 `curl -C -`（续传纪律）自行执行。本工具
**不发起任何网络请求**——镜像可用性会漂移，agent 用前自行实测（或看条目里的
verified 日期判断新鲜度），本知识库只负责"给对地址、给对映射方式"。

知识库：`configs/mirrors.json`（upstream → mirrors[]，条目带 verified 实测日期）。
镜像来源纪律：只收本环境实测过或来自已实测配置（mip/gip）的地址，禁止凭空臆造；
新增条目先实测（curl/下载验证）再 `mirror-fetch add` 入库。
"""
from __future__ import annotations

import argparse
import datetime
import json
import os
import re
import sys
import urllib.parse
from pathlib import Path

DEFAULT_KB = Path(__file__).resolve().parent.parent / "configs" / "mirrors.json"
MODES = ("host-replace", "prefix")  # 镜像 URL 与上游 URL 的映射方式
_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def kb_path() -> Path:
    override = os.environ.get("MIRROR_FETCH_CONFIG")
    return Path(override) if override else DEFAULT_KB


# ── 知识库读取/保存 ───────────────────────────────────────────────────
def load_kb(path=None) -> dict:
    """读知识库。返回 {'path', 'raw', 'upstreams'}。"""
    p = Path(path) if path else kb_path()
    try:
        raw = json.loads(p.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise SystemExit(f"error: 知识库不存在: {p}")
    except json.JSONDecodeError as e:
        raise SystemExit(f"error: 知识库不是合法 JSON: {p}: {e}")
    upstreams = raw.get("upstreams")
    if not isinstance(upstreams, dict) or not upstreams:
        raise SystemExit(f"error: {p} 缺 upstreams 映射")
    return {"path": p, "raw": raw, "upstreams": upstreams}


def save_kb(kb: dict) -> None:
    kb["raw"]["upstreams"] = kb["upstreams"]
    kb["raw"]["updated"] = datetime.date.today().isoformat()
    kb["path"].write_text(json.dumps(kb["raw"], ensure_ascii=False, indent=2) + "\n",
                          encoding="utf-8")


def validate_kb(upstreams: dict) -> list:
    """知识库完整性检查，返回违规列表（空 = 通过）。"""
    errors = []
    for up, body in upstreams.items():
        if not isinstance(body, dict):
            errors.append(f"{up}: 条目必须是对象")
            continue
        mirrors = body.get("mirrors")
        if not isinstance(mirrors, list) or not mirrors:
            errors.append(f"{up}: mirrors 列表缺失或为空")
            continue
        for i, m in enumerate(mirrors):
            url = m.get("url", "")
            mode = m.get("mode", "")
            if not isinstance(url, str) or not re.match(r"^https?://", url):
                errors.append(f"{up}.mirrors[{i}]: url 需为 http(s) 地址，实得 {url!r}")
            if mode not in MODES:
                errors.append(f"{up}.mirrors[{i}]: mode 需 ∈ {MODES}，实得 {mode!r}")
            verified = m.get("verified")
            if verified and not _DATE_RE.match(str(verified)):
                errors.append(f"{up}.mirrors[{i}]: verified 需 YYYY-MM-DD，实得 {verified!r}")
        howto = body.get("howto")
        if howto is not None and not isinstance(howto, str):
            errors.append(f"{up}: howto 需为字符串")
    return errors


# ── URL / 镜像映射（纯函数，离线）────────────────────────────────────
def normalize_url(url: str) -> str:
    if "://" not in url:
        url = "https://" + url
    parts = urllib.parse.urlparse(url)
    if not parts.netloc or any(ch.isspace() for ch in parts.netloc):
        raise ValueError(f"无法解析 URL: {url}")
    return urllib.parse.urlunparse(parts)


def lookup_upstream(url_or_host: str, upstreams: dict):
    """URL 或 host 命中某上游（含别名）→ (upstream_key, body)；否则 (None, None)。"""
    s = url_or_host.strip()
    if "://" in s:
        s = urllib.parse.urlparse(normalize_url(s)).netloc.split(":")[0]
    host = s.split(":")[0].lower()
    for up, body in upstreams.items():
        aliases = body.get("aliases") or []
        if host == up.lower() or host in (a.lower() for a in aliases):
            return up, body
    return None, None


def mapped_urls(url: str, mirror: dict) -> list:
    """按 mode 给出该镜像下可用的 URL（host-replace 换域保路径；prefix 前缀式）。"""
    u = normalize_url(url)
    parsed = urllib.parse.urlparse(u)
    base = mirror["url"].rstrip("/")
    if mirror["mode"] == "prefix":
        return [f"{base}/{u}"]
    return [urllib.parse.urlunparse(
        (parsed.scheme, urllib.parse.urlparse(base).netloc, parsed.path,
         parsed.params, parsed.query, parsed.fragment))]


# ── CLI ───────────────────────────────────────────────────────────────
def _print_mirror(m: dict, url: str | None = None) -> None:
    print(f"  - {m['url']}  [{m['mode']}]  (verified {m.get('verified', '未标注')})")
    if m.get("note"):
        print(f"    note: {m['note']}")
    if url:
        for u in mapped_urls(url, m):
            print(f"    可用 URL: {u}")


def _miss(target: str, upstreams: dict) -> None:
    host = target.split(":")[0]
    print(f"知识库无 {host!r} 的镜像条目。现有上游: {', '.join(sorted(upstreams))}")
    print("提示: 自行搜索可用镜像并实测后 `mirror-fetch add <upstream> <url> --note ...` 入库")


def cmd_lookup(args, kb) -> None:
    upstreams = kb["upstreams"]
    up, body = lookup_upstream(args.target, upstreams)
    if up is None:
        _miss(args.target, upstreams)
        return
    print(f"上游: {up}（别名: {body.get('aliases') or '-'}）")
    if body.get("howto"):
        print(f"howto: {body['howto']}")
    url = args.target if "://" in args.target else None
    for m in body["mirrors"]:
        _print_mirror(m, url)


def cmd_list(args, kb) -> None:
    upstreams = kb["upstreams"]
    for up in sorted(upstreams):
        body = upstreams[up]
        howto = (body.get("howto") or "").splitlines()[0][:60]
        print(f"{up}  别名={body.get('aliases') or '-'}  howto={howto or '-'}")
        for m in body["mirrors"]:
            print(f"  - {m['url']} [{m['mode']}] verified={m.get('verified', '-')}")
    services = kb["raw"].get("services") or []
    if services:
        print("\n已知镜像站服务目录（含非 host-replace 型）:")
        for s in services:
            print(f"  - {s.get('name')}  {s.get('url')}  [for: {s.get('for')}]")
            if s.get("note"):
                print(f"    note: {s['note']}")


def cmd_search(args, kb) -> None:
    upstreams = kb["upstreams"]
    kw = args.keyword.lower()
    hits = 0
    for up, body in upstreams.items():
        found = kw in up.lower() or any(kw in a.lower() for a in (body.get("aliases") or []))
        for m in body["mirrors"]:
            if kw in m["url"].lower() or kw in str(m.get("note", "")).lower():
                found = True
        if found:
            hits += 1
            print(f"上游: {up}")
            for m in body["mirrors"]:
                _print_mirror(m)
    for s in kb["raw"].get("services") or []:
        blob = " ".join(str(s.get(k, "")) for k in ("name", "url", "for", "note"))
        if kw in blob.lower():
            hits += 1
            print(f"服务: {s.get('name')}  {s.get('url')}  [for: {s.get('for')}]")
            if s.get("note"):
                print(f"  note: {s['note']}")
    if not hits:
        print(f"无匹配 {args.keyword!r}。现有上游: {', '.join(sorted(upstreams))}；或 `mirror-fetch list` 看服务目录")


def add_entry(kb: dict, upstream: str, mirror_url: str, mode: str,
              note: str | None = None, verified: str | None = None) -> str:
    """新增镜像条目（离线治理：去重 + 日期戳）。返回 'added' | 'exists'。"""
    if not re.match(r"^https?://", mirror_url):
        raise ValueError(f"镜像 url 需为 http(s) 地址: {mirror_url!r}")
    if mode not in MODES:
        raise ValueError(f"mode 需 ∈ {MODES}")
    body = kb["upstreams"].setdefault(upstream, {"aliases": [], "mirrors": [], "howto": ""})
    for m in body["mirrors"]:
        if m.get("url") == mirror_url:
            return "exists"
    entry = {"url": mirror_url, "mode": mode,
             "verified": verified or datetime.date.today().isoformat()}
    if note:
        entry["note"] = note
    body["mirrors"].append(entry)
    save_kb(kb)
    return "added"


def cmd_add(args, kb) -> None:
    try:
        status = add_entry(kb, args.upstream, args.mirror_url, args.mode,
                           note=args.note, verified=args.verified)
    except ValueError as e:
        raise SystemExit(f"error: {e}")
    if status == "exists":
        print(f"已存在（跳过）: {args.upstream} → {args.mirror_url}")
        return
    print(f"已入库: {args.upstream} → {args.mirror_url} [{args.mode}]")


def cmd_validate(args, kb) -> None:
    errors = validate_kb(kb["upstreams"])
    for i, s in enumerate(kb["raw"].get("services") or []):
        # 服务目录是信息性条目：只要求 name（url 可为 registry 清单等非 http 描述）
        if not s.get("name"):
            errors.append(f"services[{i}]: 缺 name")
    if errors:
        for e in errors:
            print(f"✗ {e}")
        raise SystemExit(1)
    n = sum(len(b.get("mirrors", [])) for b in kb["upstreams"].values())
    m = len(kb["raw"].get("services") or [])
    print(f"知识库 OK：{len(kb['upstreams'])} 上游 / {n} 镜像条目 / {m} 服务目录项")


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        prog="mirror-fetch",
        description="镜像站知识库查询器（查址/搜索/维护；下载请用 curl -C -，本工具不发网络请求）")
    ap.add_argument("--config", default=None, help="知识库 JSON 路径（默认随脚本的 configs/mirrors.json）")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p_l = sub.add_parser("lookup", help="按 URL 或 host 查镜像条目与可用 URL")
    p_l.add_argument("target", help="上游 URL（如 https://huggingface.co/xxx）或 host")
    p_l.set_defaults(fn=cmd_lookup)

    p_li = sub.add_parser("list", help="列出知识库全部上游与镜像")
    p_li.set_defaults(fn=cmd_list)

    p_s = sub.add_parser("search", help="按关键词搜上游/镜像/note")
    p_s.add_argument("keyword")
    p_s.set_defaults(fn=cmd_search)

    p_a = sub.add_parser("add", help="新增镜像条目（离线治理：去重 + 日期戳）")
    p_a.add_argument("upstream", help="上游 host（如 huggingface.co）")
    p_a.add_argument("mirror_url", help="镜像站地址（如 https://hf-mirror.com）")
    p_a.add_argument("--mode", choices=MODES, default="host-replace")
    p_a.add_argument("--note", default=None, help="备注（实测日期/限制等）")
    p_a.add_argument("--verified", default=None, help="实测日期 YYYY-MM-DD（默认今天）")
    p_a.set_defaults(fn=cmd_add)

    p_v = sub.add_parser("validate", help="知识库完整性检查（CI/测试用）")
    p_v.set_defaults(fn=cmd_validate)
    return ap


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    kb = load_kb(args.config)
    args.fn(args, kb)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit as e:
        raise e
    except KeyboardInterrupt:
        sys.exit(130)
